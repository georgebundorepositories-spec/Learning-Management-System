# Public frontend connection fields only; set real values in local untracked files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix secrets with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
AT_USERNAME=
AT_API_KEY=

# One-time admin bootstrap (ignored file or CI secret variables only)
ZIMLMS_SCHOOL_NAME=
ZIMLMS_ADMIN_FULL_NAME=
ZIMLMS_ADMIN_PHONE=
ZIMLMS_ADMIN_EMAIL=
ZIMLMS_ADMIN_PASSWORD=

# Supabase Edge Function secret, not a browser variable.
# Configure in the Supabase project only after the production HTTPS web origin
# exists and its /accept-invite redirect is allow-listed in Auth settings.
# ZIMSCHOOL_WEB_ORIGIN=https://your-verified-school-domain.example
